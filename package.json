{
  "name": "work-hq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A proactive ops dashboard for people who manage too many threads: asks the right question at the right time, captures commitments live, and dispatches pi agents you can watch.",
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
