// Work HQ config. Copy to ./work-hq.config.json or ~/.config/work-hq/config.json
// (or point WORK_HQ_CONFIG at it). Every key is optional; delete what you don't need.
// Comments and trailing commas are fine. Paths may start with ~ ; relative paths resolve next to this file.
// Check what got picked up with:  bin/work-hq config
{
  // Who the dashboard works for. Goes into every prompt.
  "owner": {
    "name": "Alex",
    "role": "Engineering Manager",
    "company": "Acme",
    "location": "Lisbon",
    "timezone": "Europe/Lisbon",          // defaults to the system timezone
    "aliases": ["alex", "alex.kim"],      // "me" in attendee lists (hidden in the UI)
    "speechLang": "en-GB"                 // dictation + 🍍 listener
  },

  "server": { "port": 7717 },

  // Where agents run (their cwd) and where scratch files go: your notes vault, agent home, or ~.
  "workspace": {
    "dir": "~/notes",
    "scratchDir": "~/notes/scratch",
    "obsidianVault": "notes"               // set if workspace.dir is an Obsidian vault; drafts then open in Obsidian
  },

  // Optional. An MCP server exposing read / write / list / search over markdown files
  // (e.g. agent-memory-mcp). Without it, Work HQ runs fine; it just can't import to-dos or save the journal.
  "memory": {
    "url": "https://memory.example.com/mcp",
    "tokenFile": "~/.config/work-hq/memory-token",   // or "token": "…" (keep it out of git), or WORK_HQ_MEMORY_TOKEN
    "todosPath": "memory/workload/active-todos.md",   // markdown checkboxes under ## headings
    "proposalsDir": "memory/workload/plans",          // dated *-improvement-proposals.md; newest is read
    "journalPath": "memory/workload/work-hq-journal.md",
    "importEveryMin": 30,
    "flushEveryMin": 5
  },

  // pi is the only thing that talks to a model. Empty model = pi's default.
  "pi": {
    "bin": "~/.local/bin/pi",
    "model": "",
    "triageThinking": "low",
    "sweepThinking": "medium",
    // Extra env for headless (read-only) sweeps, e.g. to pre-approve MCP reads in a permissions extension.
    "headlessEnv": {},
    // Space out pi launches (seconds) so bursts stay under per-minute provider limits. 0 = off.
    "launchSpacingSec": 20,
    // On a rate-limit / 429 / 503 / overloaded error: retry this many times, waiting a random time in this range (seconds).
    "rateLimitRetries": 2,
    "rateLimitBackoffSec": [60, 90],
    // Headless runs: "rpc" (prompt over stdin, warm triage worker) or "print" (old `pi -p @file`).
    "runner": "rpc",
    "triageWorkers": 1,                   // warm triage workers (~190 MB each); 0 = one per request
    "stallMin": 10                        // abort a headless tool run with no activity for this long
    // Share one model-gateway token across runs, if your provider's key command reads an env var first:
    // "gatewayToken": { "env": "OPENCODE_CF_TOKEN", "command": "cloudflared access token -app=https://…" }
  },

  // Optional: read deadlines the built-in parser can't ("before the offsite", "within two weeks") with
  // Workers AI's Clairic model, one batched call per memory import. Token: Workers AI Read only.
  // "deadlines": { "clairic": { "accountId": "…", "tokenFile": "~/.config/work-hq/workers-ai-token", "minConfidence": 0.9 } },

  // Background sweeps. Only run on weekdays inside work hours.
  "sweeps": {
    "dayStart": 8,
    "dayEnd": 19,
    "calendarEveryMin": 120,
    "transcriptsEveryMin": 30,
    "postsEveryDays": 7,                  // writing scout; 0 = off
    "disabled": []                         // any of "calendar", "transcripts", "posts", "checks"
  },

  // Morning checks: plain shell commands (no pi), run once per workday from dayStart, so their
  // findings are on the board before the morning plan. Each prints { "items": [...] } JSON on
  // stdout, every item with a stable source.key. An item a later run stops reporting is closed
  // as done. Exit code is ignored when stdout parses. Disable all with sweeps.disabled: ["checks"].
  // "after": "HH:MM" holds a check until that time of day, e.g. a token check before a nightly job.
  // "everyMin": N runs it every N minutes in work hours instead of once a day (toasts only new items).
  // A check can also print "questions" about its own items: { "itemKey": <item source.key>, "key",
  // "prompt", "options": [{ "label", "status" } | { "label", "action", "note" }] }. Asked once per key;
  // an action's "note" tells the dispatched agent which option was picked.
  "checks": [
    // { "name": "unlanded", "command": "bun run --silent --cwd ~/code/mr-tools unlanded --whq", "timeoutSec": 180 },
    // { "name": "auth", "command": "~/bin/auth-check --whq", "after": "17:00" },
    // { "name": "failing-runs", "command": "bun run --silent --cwd ~/code/mr-tools failing --whq", "everyMin": 10 }
  ],

  // Repos several agents edit at once. A work job on an item of `project` (or whose title matches `match`)
  // gets its own worktree of `dir` (scripts/worktree.sh), made before launch, and lands it with
  // `whq land <jobId>`: rebase on main, `check`, push, `publish`, remove the worktree, `restart` if code changed.
  "repos": [
    // { "project": "work-hq", "dir": "~/code/work-hq", "check": "bun test && bun run typecheck",
    //   "publish": "scripts/publish.sh github", "restart": "launchctl kickstart -k gui/$(id -u)/work-hq.dashboard" }
  ],

  // Ticket prefixes / keywords that tag items with a project badge.
  "projects": [
    { "key": "PAY", "match": "payments|checkout" },
    { "key": "INFRA" }
  ],

  // Words used in prompts and the UI.
  // trackerUrl: ticket keys like PAY-123 anywhere in the UI become links to <trackerUrl>PAY-123.
  "labels": { "tracker": "Linear", "chat": "Slack", "trackerUrl": "https://linear.app/acme/issue/" },
  // jira.hosts: JIRA hosts whose /browse/KEY links are checked (cloudflared Access token) so waiting items whose tickets
  // are all done reach the "Ticket done" card. Default: labels.trackerUrl's host when it ends in /browse/.
  // "jira": { "hosts": ["jira.example.com"] },

  // Blog-post scouting and drafting. Leave site.postsDir out if you don't have a public site.
  "writing": {
    "wiki": { "name": "Confluence", "draftsDir": "~/notes/scratch/blog-drafts" },
    "site": { "name": "alex.dev", "postsDir": "~/dev/alex.dev/src/content/posts", "repoDir": "~/dev/alex.dev" }
  },

  // Your company's tools and conventions go here: copy any file from ./prompts into this folder and edit it.
  // Missing files fall back to the defaults.
  "promptsDir": "~/.config/work-hq/prompts",

  // Dispatched agents run in cmux workspaces under this group. Once a job's session has sat idle
  // pruneIdleHours, its workspace is closed (0 = never). Selected or pinned workspaces are left alone,
  // and the pi session file stays, so `pi --resume` brings it back.
  "cmux": { "group": "Work HQ", "pruneIdleHours": 3 },

  // Push-to-talk dictation (command-bar mic, "Scheduled for…"). The 🍍 listener always uses Chrome's Web Speech.
  //   "auto"    → HEX if it's running (found via its local API, no setup), else "command" if set, else Web Speech
  //   "hex" | "command" | "browser" to pin one. Recorded engines stop on silenceMs of quiet, or ↵ / ⌘↵.
  "voice": {
    "dictation": "auto",
    // Any local transcriber. {file} is a 16 kHz mono WAV; stdout is the text.
    // "command": "whisper-cli -m ~/models/ggml-base.en.bin -nt -np -f {file}",
    "hex": { "model": "" },               // empty = the model selected in HEX
    "silenceMs": 1400
  },

  // Corporate TLS proxy? Root CA bundle, exported to bun and every pi it starts.
  "tls": { "caFile": "~/certs/corp-root.pem" }
}
