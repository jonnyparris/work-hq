#!/bin/bash
# whq — tiny client for Work HQ, used by dispatched pi sessions.
#
#   whq report <jobId>        # JSON report on stdin → POST /api/agent/report
#   whq say "<text>"          # talk to Work HQ like the command bar does
#   whq pineapple "<text>"    # capture an action (🍍) from any terminal
#   whq journal "<text>"      # add a line to the journal as an agent (no triage)
#   whq sync <memory|journal|calendar|transcripts>
#   whq recheck               # re-read every open item's MRs / PRs / tickets; result shows in the dashboard
#   whq land <jobId>          # land a work job's worktree: rebase, check, push, publish, clean up, restart
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
URL="${WORK_HQ_URL:-http://127.0.0.1:7717}"
cmd="${1:-}"; shift || true
post() { curl -sS -X POST "$URL$1" -H 'content-type: application/json' --data-binary @-; echo; }
jstr() { python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"; }
case "$cmd" in
  report)
    job="${1:?usage: whq report <jobId> < report.json}"
    python3 -c 'import json,sys; d=json.load(sys.stdin); d["jobId"]=sys.argv[1]; print(json.dumps(d))' "$job" | post /api/agent/report | python3 -c '
import json,sys
raw=sys.stdin.read(); print(raw.rstrip())
try: qs=json.loads(raw).get("questions") or []
except Exception: qs=[]
for q in qs:
  print(("Asked: " if q["asked"] else "Not asked (same question already open, or answered with once): ")+q["prompt"])
  for o in q["options"]: print("  "+o)
if any(" noop " in o for q in qs for o in q["options"]): print("A noop button does nothing when tapped. If that is wrong, re-report with an explicit status/action.")
if any(o.endswith("(no agent starts)") for q in qs for o in q["options"]): print("A button that approves work but only sets a status starts no agent. Re-report it with action \"work\" and a note, under a new key.")
try: fo=json.loads(raw).get("folded") or []
except Exception: fo=[]
if fo: print("Not filed (idea cap per job; added to the summary as \"Could also:\"): "+"; ".join(fo))' ;;
  say)       echo "{\"text\": $(jstr "$*")}" | post /api/say ;;
  pineapple) echo "{\"text\": $(jstr "$*"), \"mode\": \"pineapple\"}" | post /api/say ;;
  journal)   echo "{\"text\": $(jstr "$*")}" | post /api/journal ;;
  sync)      echo '{}' | post "/api/sync/${1:?name}" ;;
  recheck)   echo '{}' | post /api/recheck ;;
  land)      cd "$ROOT" && exec "${BUN:-$(command -v bun || echo "$HOME/.bun/bin/bun")}" src/cli/land.ts "${1:?usage: whq land <jobId>}" ;;
  *) sed -n '2,10p' "$0"; exit 2 ;;
esac
